#!/bin/sh
# Refuse un message de commit qui ne suit pas Conventional Commits 1.0.0 (https://www.conventionalcommits.org) :
#   type(portée)?!?: description
# Activation : npm run hooks:install   (équivaut à : git config core.hooksPath .githooks)
# POSIX sh : le hook et son test tournent aussi dans l'image Alpine (sans bash).

message_file="$1"
subject=$(grep -v '^#' "$message_file" | sed -n '1p')

# Commits générés par git : fusion, annulation, fixup/squash/amend (réécrits avant publication).
case "$subject" in
  'Merge '*|'Revert "'*|'fixup! '*|'squash! '*|'amend! '*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\\([a-z0-9._/-]+\\))?!?: [^ ]" && [ "${#subject}" -le 100 ]; then
  exit 0
fi

cat >&2 <<MESSAGE
Message de commit refusé : « $subject »

Format attendu (Conventional Commits) :  type(portée): description
  types   : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  portée  : facultative, en minuscules (ui, api, ci, docker, site, mirror…)
  ! avant les deux-points : changement incompatible (feat(api)!: …)
  première ligne : 100 caractères au plus, en anglais, à l'impératif, sans point final

Exemples :
  fix(ci): expire malformed review dates
  feat(meeting): add a hit count filter
  build(deps): update vite to 8.3.8
MESSAGE
exit 1
